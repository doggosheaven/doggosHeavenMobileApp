{
  "expo": {
    "name": "Doggos Heaven",
    "slug": "doggosheaven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doggosheaven",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doggosheaven.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Doggos Heaven to use your camera to take pet photos.",
        "NSPhotoLibraryUsageDescription": "Allow Doggos Heaven to access your photos to upload pet pictures.",
        "NSPhotoLibraryAddUsageDescription": "Allow Doggos Heaven to save photos to your library."
      }
    },
    "android": {
      "package": "com.doggosheaven.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/doggoswhite.png",
        "backgroundColor": "#0B3D2E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/doggoswhite.png",
          "color": "#0B3D2E",
          "sounds": [],
          "androidMode": "default",
          "androidCollapsedTitle": "Doggos Heaven"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/doggoswhite.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Doggos Heaven to access your photos to upload pet pictures.",
          "cameraPermission": "Allow Doggos Heaven to use your camera to take pet photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "940fc4bb-a36c-411b-b94b-164849675a08"
      }
    },
    "owner": "deepakgupta4"
  }
}
